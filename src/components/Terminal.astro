---
// A terminal window showing invented output. Every one is tagged
// "illustrative" and carries data-illustrative, which fails a production build
// (see build-hooks.mjs): examples only ship once they match what delocal does.
//
// Each line is a list of segments: plain text, or [tone, text] to colour it.
// Columns line up because the body is monospace with white-space: pre.
type Tone = "prompt" | "path" | "cmd" | "dim" | "ok" | "held" | "laptop" | "desk" | "nas";
export type Line = (string | [Tone, string])[];

interface Props {
  // Shown in the title bar, such as "~/Sync".
  title: string;
  // Names the example for screen readers, and in the production build error.
  label: string;
  lines: Line[];
}
const { title, label, lines } = Astro.props;
---

<div class="terminal">
  <div class="title-bar" aria-hidden="true">
    <span class="dots"><span></span><span></span><span></span></span>
    <span class="title">{title}</span>
    <span class="tag">illustrative</span>
  </div>
  <pre role="group" aria-label={`Illustrative example: ${label}`} tabindex="0" data-illustrative>{lines.map((line, i) => <>{i > 0 && "\n"}{line.map((segment) => (typeof segment === "string" ? segment : <span class={segment[0]}>{segment[1]}</span>))}</>)}</pre>
</div>

<style>
  .terminal {
    min-width: 0;
    border: 1px solid var(--rule);
    border-radius: var(--radius-card);
    background: var(--terminal);
  }

  .title-bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 12px;
    height: 50px;
    padding: 0 18px;
    border-bottom: 1px solid var(--rule);
  }
  .dots {
    display: flex;
    gap: 9px;
  }
  .dots span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--rule-strong);
  }
  .title {
    color: var(--faint);
    font-family: var(--font-code);
    font-size: 13px;
  }
  .tag {
    justify-self: end;
    padding: 1px 8px;
    border-radius: 4px;
    background: var(--rule-strong);
    color: var(--ink);
    font-family: var(--font-code);
    font-size: 12px;
    line-height: 19px;
  }

  pre {
    margin: 0;
    padding: 26px;
    overflow-x: auto;
    border-radius: 0 0 var(--radius-card) var(--radius-card);
    color: var(--text-2);
    font-size: 15px;
    line-height: 26px;
    white-space: pre;
  }
  pre:focus-visible {
    outline-offset: -2px;
  }

  .prompt,
  .held {
    color: var(--amber);
  }
  .path {
    color: var(--muted);
  }
  .cmd {
    color: var(--ink);
  }
  .dim {
    color: var(--faint);
  }
  .ok {
    color: var(--green);
  }
  .laptop {
    color: var(--laptop);
  }
  .desk {
    color: var(--desk);
  }
  .nas {
    color: var(--nas);
  }
</style>
