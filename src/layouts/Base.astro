---
// The document shell for our own pages (Starlight renders its own).
import "../styles/fonts.css";
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/placeholder.css";
import { SITE_URL } from "../../site.config.mjs";
import { shareImageMeta } from "../lib/share-image.mjs";

interface Props {
  title: string;
  description: string;
  // For a page search engines must not index, such as the 404 page. It gets
  // a robots noindex meta tag instead of a canonical link.
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {/* A noindex page, such as 404, is served at many addresses, so it has no og:url. */}
    {!noindex && <meta property="og:url" content={canonical} />}
    {shareImageMeta.map((attrs) => <meta {...attrs} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#14152a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <slot />
  </body>
</html>
